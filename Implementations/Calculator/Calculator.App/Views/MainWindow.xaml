<Window x:Class="Calculator.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.App"
        mc:Ignorable="d"
        Title="Calculator" Height="500" Width="350">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <TextBox Grid.Row="0" Text="{Binding Display}" FontSize="40" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="True" Margin="5"/>

        <!-- Buttons -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Row 1 -->
            <Button Grid.Row="0" Grid.Column="0" Content="7" Command="{Binding NumberCommand}" CommandParameter="7"/>
            <Button Grid.Row="0" Grid.Column="1" Content="8" Command="{Binding NumberCommand}" CommandParameter="8"/>
            <Button Grid.Row="0" Grid.Column="2" Content="9" Command="{Binding NumberCommand}" CommandParameter="9"/>
            <Button Grid.Row="0" Grid.Column="3" Content="/" Command="{Binding OperationCommand}" CommandParameter="/"/>

            <!-- Row 2 -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding NumberCommand}" CommandParameter="4"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding NumberCommand}" CommandParameter="5"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding NumberCommand}" CommandParameter="6"/>
            <Button Grid.Row="1" Grid.Column="3" Content="*" Command="{Binding OperationCommand}" CommandParameter="*"/>

            <!-- Row 3 -->
            <Button Grid.Row="2" Grid.Column="0" Content="1" Command="{Binding NumberCommand}" CommandParameter="1"/>
            <Button Grid.Row="2" Grid.Column="1" Content="2" Command="{Binding NumberCommand}" CommandParameter="2"/>
            <Button Grid.Row="2" Grid.Column="2" Content="3" Command="{Binding NumberCommand}" CommandParameter="3"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-" Command="{Binding OperationCommand}" CommandParameter="-"/>

            <!-- Row 4 -->
            <Button Grid.Row="3" Grid.Column="0" Content="0" Command="{Binding NumberCommand}" CommandParameter="0"/>
            <Button Grid.Row="3" Grid.Column="1" Content="." Command="{Binding NumberCommand}" CommandParameter="."/>
            <Button Grid.Row="3" Grid.Column="2" Content="=" Command="{Binding EqualsCommand}"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Command="{Binding OperationCommand}" CommandParameter="+"/>

        </Grid>

    </Grid>
</Window>
